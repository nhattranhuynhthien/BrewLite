public List<PromotionDTO> search(String keyword, String type) { //1
    List<PromotionDTO> all = promotionDAO.selectAllPromotions(); //1

    if (keyword == null || keyword.isEmpty())//2
        return all; //3

   else
   {
     List<PromotionDTO> result = new ArrayList<>(); //4
    String lowerKeyword = keyword.toLowerCase(); //4

    int i = 0; //4
    while (i < all.size()) { //5
        PromotionDTO p = all.get(i);
        boolean match; //6

        switch (type) { //7
            case "Tên": //8
                match = p.getPromotionName()
                         .toLowerCase()
                         .contains(lowerKeyword); //9
                break;

            case "Phần trăm": //10
                try {
                    double percent = Double.parseDouble(lowerKeyword); //11
                    match = (p.getPercent() == percent);
                } catch (Exception e) {
                    match = false; //12
                }
                break;

            case "Thời gian": //13
                try {
                    String[] dates = lowerKeyword.split("\\|");

                    SimpleDateFormat sdf =
                            new SimpleDateFormat("yyyy-MM-dd"); //14

                    long startLimit = (dates[0].isEmpty())
                            ? 0
                            : sdf.parse(dates[0]).getTime();

                    long endLimit = (dates.length < 2 || dates[1].isEmpty())
                            ? Long.MAX_VALUE
                            : sdf.parse(dates[1]).getTime();

                    match = (p.getStartDate().getTime() >= startLimit
                            && p.getEndDate().getTime() <= endLimit);

                } catch (Exception e) {
                    match = false; //15
                }
                break;

            default: //16
                match = true; //17
                break;
        }

        if (match) { //18
            result.add(p); //19
        }

        i++; //20
    } //21
   }

    return result; //22
}